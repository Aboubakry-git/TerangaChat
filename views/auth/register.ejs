<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Inscription' }) %>
  <link rel="stylesheet" href="/css/whatsapp.css">
</head>
<body class="auth-body">
  <button class="auth-theme-toggle" id="themeToggle" type="button" aria-label="Changer de thème"><i class="fas fa-moon"></i><span>Mode sombre</span></button>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-logo">
        <img class="auth-logo-mark" src="/images/logo-chats.svg" alt="Logo TerangaChat">
        <h1>TerangaChat</h1>
        <p class="auth-subtitle">Créez votre compte</p>
      </div>
      <% if (error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <form action="/register" method="POST" class="auth-form">
        <div class="form-group">
          <label for="username"><i class="fas fa-at"></i> Nom d'utilisateur</label>
          <input type="text" id="username" name="username" value="<%= oldInput.username || '' %>" placeholder="mon_nom" required autofocus>
        </div>
        <div class="form-group">
          <label for="email"><i class="fas fa-envelope"></i> Email</label>
          <input type="email" id="email" name="email" value="<%= oldInput.email || '' %>" placeholder="email@exemple.com" required>
        </div>
        <div class="form-group">
          <label for="fullName"><i class="fas fa-id-card"></i> Nom complet (optionnel)</label>
          <input type="text" id="fullName" name="fullName" value="<%= oldInput.fullName || '' %>" placeholder="Jean Dupont">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="password"><i class="fas fa-lock"></i> Mot de passe</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>
          </div>
          <div class="form-group">
            <label for="confirmPassword"><i class="fas fa-lock"></i> Confirmer</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
          </div>
        </div>
        <div class="password-hint">
          <small>8 caractères min, 1 majuscule, 1 chiffre, 1 caractère spécial</small>
        </div>
        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-user-plus"></i> S'inscrire</button>
      </form>
      <div class="auth-links">
        <a href="/login">Déjà un compte ? Se connecter</a>
      </div>
    </div>
  </div>
  <script src="/js/theme.js"></script>
</body>
</html>
