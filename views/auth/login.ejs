<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Connexion' }) %>
  <link rel="stylesheet" href="/css/whatsapp.css">
</head>
<body class="auth-body">
  <button class="auth-theme-toggle" id="themeToggle" type="button" aria-label="Changer de thème"><i class="fas fa-moon"></i><span>Mode sombre</span></button>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-logo">
        <img class="auth-logo-mark" src="/images/logo-chats.svg" alt="Logo TerangaChat">
        <h1>TerangaChat</h1>
        <p class="auth-subtitle">Connectez-vous pour discuter</p>
      </div>
      <% if (error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="identifier"><i class="fas fa-user"></i> Email ou nom d'utilisateur</label>
          <input type="text" id="identifier" name="identifier" value="<%= oldInput.identifier || '' %>" placeholder="email@exemple.com" required autofocus>
        </div>
        <div class="form-group">
          <label for="password"><i class="fas fa-lock"></i> Mot de passe</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>
        <div class="form-check">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <label for="rememberMe">Se souvenir de moi</label>
        </div>
        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-sign-in-alt"></i> Se connecter</button>
      </form>
      <div class="auth-links">
        <a href="/forgot-password">Mot de passe oublié ?</a>
        <span>·</span>
        <a href="/register">Créer un compte</a>
      </div>
    </div>
  </div>
  <script src="/js/theme.js"></script>
</body>
</html>
