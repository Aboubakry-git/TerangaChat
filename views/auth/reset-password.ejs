<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head', { title: 'Réinitialiser le mot de passe' }) %>
  <link rel="stylesheet" href="/css/whatsapp.css">
</head>
<body class="auth-body">
  <button class="auth-theme-toggle" id="themeToggle" type="button" aria-label="Changer de thème"><i class="fas fa-moon"></i><span>Mode sombre</span></button>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-logo">
        <i class="fas fa-key"></i>
        <h1>Nouveau mot de passe</h1>
      </div>
      <% if (error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <form action="/reset-password" method="POST" class="auth-form">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-group">
          <label for="password"><i class="fas fa-lock"></i> Nouveau mot de passe</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autofocus>
        </div>
        <div class="form-group">
          <label for="confirmPassword"><i class="fas fa-lock"></i> Confirmer</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-check"></i> Réinitialiser</button>
      </form>
    </div>
  </div>
  <script src="/js/theme.js"></script>
</body>
</html>
