# ============================================================
# TerangaChat — Exemple de configuration
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs réelles :
#   cp .env.example .env
# ⚠️ Ne commitez JAMAIS le fichier .env sur Git
# ============================================================

# ===== Serveur =====
PORT=3000
NODE_ENV=development
# Générez un secret aléatoire long :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_with_a_long_random_string

# ===== Cassandra =====
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=whatsapp_clone
CASSANDRA_USERNAME=your_cassandra_user
CASSANDRA_PASSWORD=your_cassandra_password

# ===== JWT =====
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Upload de fichiers =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# ===== Email (réinitialisation de mot de passe) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ===== WebRTC / PeerJS =====
PEERJS_PORT=9000
PEERJS_PATH=/peerjs
# TURN local (coturn) — obligatoire si audio/vidéo muet après décroché sur LAN
# Exemple : turn:192.168.1.176:3478,turn:192.168.1.176:3478?transport=tcp
TURN_URLS=turn:192.168.1.176:3478,turn:192.168.1.176:3478?transport=tcp
TURN_USERNAME=teranga
TURN_CREDENTIAL=TerangaTurn2026!

# ===== HTTPS =====
USE_HTTPS=false
